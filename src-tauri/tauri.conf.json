{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHUD",
  "version": "0.1.0",
  "identifier": "com.sayan.devhud",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/devhud/browser"
  },
  "app": {
    "windows": [
      {
        "title": "DevHUD",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
